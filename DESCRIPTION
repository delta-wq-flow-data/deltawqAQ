Package: deltawqAQ
Type: Package
Title: Obtain water quality timeseries and metadata from Aquarius database
Version: 0.1.0
Authors@R: c(
    person("Catarina", "Pien", email = "cpien@flowwest.com", role = c("aut", "cre")),
    person("Emanuel", "Rodriguez", email = "erodriguez@flowwest.com", role = "aut")
